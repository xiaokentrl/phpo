# 构建产物
/phpo
/build/bin/
/frontend/dist/*
!/frontend/dist/index.html
/frontend/node_modules/
/frontend/bindings/

# 本地数据与密钥（签名私钥绝不入库；公钥 build/signing/public.key 入库）
*.key
# 公钥入库（go:embed 编译依赖；*.key 规则只针对私钥，此处反选回公钥）
!internal/updater/signing/public.key
.env
*.db
*.db-wal
*.db-shm

# 工具缓存
.air/
.gocache/
coverage.out
